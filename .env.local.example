# Copy to .env.local for local development (Next.js reads .env.local
# automatically and it's already git-ignored — never commit real values).

# Base URL of the plaza-api backend this frontend talks to. Public
# (NEXT_PUBLIC_*) because it's read in the browser, not just on the server —
# every API call in lib/api/client.ts uses it, with a localhost:3000
# fallback only if this is left unset entirely.
#
# For local development, point this at your local plaza-api:
NEXT_PUBLIC_API_URL=http://localhost:3000

# For a deployed frontend, point this at the deployed backend's own URL, and
# make sure that backend's CORS_ORIGIN (see plaza-api/.env.example) includes
# this frontend's deployed origin — otherwise every request is blocked by
# CORS with no data ever reaching the UI.
# NEXT_PUBLIC_API_URL=https://api.your-domain.com
